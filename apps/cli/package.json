{
	"name": "specto-cli",
	"version": "1.1.0",
	"description": "GitHub organization metrics CLI",
	"type": "module",
	"bin": {
		"specto": "dist/index.js"
	},
	"scripts": {
		"dev": "bun run src/index.ts",
		"build": "bun build src/index.ts --outdir dist --target node --minify",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@clack/prompts": "^0.11.0",
		"@specto/core": "workspace:*",
		"commander": "^14.0.3",
		"ora": "^9.4.1",
		"picocolors": "^1.1.1"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"@types/node": "^25.9.9",
		"bun-types": "^1.4.2"
	},
	"keywords": [
		"github",
		"organization",
		"metrics",
		"cli",
		"specto"
	],
	"author": "Specto",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"files": [
		"dist"
	]
}
