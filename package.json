{
	"name": "specto",
	"version": "1.0.1",
	"author": "Specto",
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"turbo": "^2.11.7",
		"typescript": "^5.9.3"
	},
	"description": "GitHub organization metrics - CLI, desktop app, and web dashboard",
	"license": "MIT",
	"packageManager": "bun@1.4.1",
	"private": true,
	"scripts": {
		"dev": "turbo dev --filter=!./apps/cli",
		"build": "turbo build",
		"test": "turbo test",
		"typecheck": "turbo typecheck",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"clean": "turbo clean && rm -rf node_modules"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
