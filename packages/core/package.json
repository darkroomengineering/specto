{
	"name": "@specto/core",
	"version": "1.0.0",
	"description": "Shared types and GitHub client for Specto",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"dev": "tsc --watch",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist",
		"test": "bun test"
	},
	"devDependencies": {
		"@types/node": "^25.9.9",
		"@types/bun": "^1.4.2"
	},
	"author": "Specto",
	"license": "MIT"
}
